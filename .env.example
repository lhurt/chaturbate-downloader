# Port exposed on the NAS.
PORT=8000

# Log verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Docker json-file log rotation (per container log file / number of files kept)
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# Replace this with the exact address you will use in the browser.
# Examples:
# CORS_ORIGINS=http://192.168.1.50:8000
# CORS_ORIGINS=http://nas.local:8000,http://192.168.1.50:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Contact Sheet configuration
# seconds between sampled frames
CONTACT_SHEET_INTERVAL_SECONDS=60
# width in px of each tile
CONTACT_SHEET_TILE_WIDTH=160
# columns per row
CONTACT_SHEET_COLUMNS=10
# generate automatically for new downloads and backfill existing files (true/false)
CONTACT_SHEET_AUTO_GENERATE=false

# Width of the contact sheet / video player modal dialogs, as a percentage of page width
MODAL_WIDTH_PERCENT=80

# Optional HTTP proxy for Chaturbate and HLS CDN requests (leave unset unless
# the assigned CDN edge times out from your network)
# CB_PROXY_URL=http://user:pass@proxy.example:8080

# Max number of automatic (auto-record) downloads that may run concurrently
AUTO_DOWNLOAD_MAX_CONCURRENT=4